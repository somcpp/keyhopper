# ==================== keyhopper ====================
# Paste as many API keys as you like, comma separated.
# When one key hits its rate limit, keyhopper switches to the next key,
# then the next model, then the next provider. Leave blank what you don't use.
# Docs: https://github.com/somcpp/keyhopper

# --- Keys (free tiers: console.groq.com, aistudio.google.com, build.nvidia.com, openrouter.ai)
GROQ_API_KEYS=
GEMINI_API_KEYS=
NVIDIA_API_KEYS=
OPENROUTER_API_KEYS=
# CEREBRAS_API_KEYS=
# MISTRAL_API_KEYS=
# TOGETHER_API_KEYS=
# DEEPSEEK_API_KEYS=
# OPENAI_API_KEYS=

# --- Models, best first (optional). Each model has its OWN rate limit,
#     so listing 2-3 per provider multiplies your free quota.
# GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# NVIDIA_MODELS=meta/llama-3.3-70b-instruct

# --- Order to try providers in (optional; default: groq,cerebras,gemini,nvidia,openrouter,...)
# KEYHOPPER_PROVIDERS=groq,gemini,nvidia

# --- "priority" = best provider first (default) | "round-robin" = spread load evenly
# KEYHOPPER_STRATEGY=priority

# --- Print a log line per request: who answered, failovers, reset times
# KEYHOPPER_LOG=true

# --- Any other OpenAI-compatible API: add its name to KEYHOPPER_PROVIDERS, then
# MYLLM_BASE_URL=https://example.com/v1
# MYLLM_API_KEYS=
# MYLLM_MODELS=some-model

# --- Server mode only: clients must send "Authorization: Bearer <token>"
# KEYHOPPER_TOKEN=
# ================== end keyhopper ==================
